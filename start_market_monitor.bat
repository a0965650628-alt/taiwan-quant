@echo off
chcp 65001 >nul
title 台股量化交易系統 - 盤中即時監控 (守護進程版)
cd /d "%~dp0"
echo ========================================================
echo   台股量化高併發監控系統 (盤中即時掃描 + 守護自癒)
echo   啟動時間: %date% %time%
echo ========================================================

:LOOP
python main.py
echo ========================================================
echo   [守護自癒提示] 監控程序於 %time% 退出 (代碼: %errorlevel%)
echo   系統將於 5 秒後自動重啟監控防護...
echo ========================================================
timeout /t 5
goto LOOP
